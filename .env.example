SMTP_PORT=587
SMTP_USER=usuario@seudominio.com.br
SMTP_PASS=sua_senha
# SMTP_SECURE=true apenas quando usar porta 465


# Central de E-mails RH / Microsoft 365 (somente servidor)
# Criar um App Registration no Microsoft Entra com Microsoft Graph Mail.Read (Application) + Admin Consent.
ACCOUNTING_EMAIL_PROVIDER=microsoft
ACCOUNTING_MS_TENANT_ID=seu-tenant-id
ACCOUNTING_MS_CLIENT_ID=seu-client-id
ACCOUNTING_MS_CLIENT_SECRET=seu-client-secret
ACCOUNTING_MS_MAILBOX=adm.matriz@topac.com.br
ACCOUNTING_EMAIL_SYNC_LOOKBACK_DAYS=30
ACCOUNTING_EMAIL_SYNC_MAX_MESSAGES=60

# Usado pela Vercel para autenticar o sincronismo automático.
